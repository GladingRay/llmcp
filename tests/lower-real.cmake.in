execute_process(
  COMMAND "@LLMCP_DUMP@" --model "@LLMCP_MODEL_DIR@"
          --verify-module -o "@LLMCP_GRAPH@"
  RESULT_VARIABLE dump_result)
if(NOT dump_result EQUAL 0)
  message(FATAL_ERROR "llmcp-dump failed with ${dump_result}")
endif()

execute_process(
  COMMAND "@LLMCP_OPT@" "@LLMCP_GRAPH@"
          --llmcp-fuse-linear-activations
          --llmcp-lower-to-linalg -o "@LLMCP_LINALG@"
  RESULT_VARIABLE lower_result)
if(NOT lower_result EQUAL 0)
  message(FATAL_ERROR "llmcp-lower-to-linalg failed with ${lower_result}")
endif()

execute_process(
  COMMAND "@LLMCP_OPT@" "@LLMCP_LINALG@" --llmcp-parallelize
          -o "@LLMCP_LINALG@"
  RESULT_VARIABLE parallelize_result)
if(NOT parallelize_result EQUAL 0)
  message(FATAL_ERROR "llmcp-parallelize failed with ${parallelize_result}")
endif()

file(READ "@LLMCP_LINALG@" contents)
foreach(remaining_op
    "llmcp.linear "
    "llmcp.rms_norm "
    "llmcp.add "
    "llmcp.silu_mul "
    "llmcp.mul "
    "llmcp.embedding "
    "llmcp.gated_rms_norm "
    "llmcp.lm_head "
    "llmcp.causal_conv1d "
    "llmcp.gated_delta_net "
    "llmcp.attention ")
  string(FIND "${contents}" "${remaining_op}" position)
  if(NOT position EQUAL -1)
    message(FATAL_ERROR "lowered graph still contains ${remaining_op}")
  endif()
endforeach()
