import os

import lit.formats

config.llmcp_opt = "@LLMCP_OPT@"
config.filecheck = "@LLMCP_FILECHECK@"
if "@LLMCP_ENABLE_BFDOT@" == "ON":
    config.available_features.add("bfdot")
if "@LLMCP_ENABLE_SDOT@" == "ON":
    config.available_features.add("sdot")
config.test_exec_root = "@LLMCP_TEST_EXEC_ROOT@"

lit_config.load_config(config, "@LLMCP_LIT_CFG@")
